<Window x:Class="LinkFlow.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LinkFlow.Models"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="LinkFlow"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">



    <!-- Outer Container with Shadow and 16px Rounded Corners -->
    <Border Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Border CornerRadius="16"
                Background="#F0181820"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1.2"
                ClipToBounds="True">
            <Grid Margin="18,16,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header & URL -->
                    <RowDefinition Height="Auto" /> <!-- Browser Cards List -->
                    <RowDefinition Height="Auto" /> <!-- Bottom Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header & URL Capsule -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Title Bar row: App Name + Drag + Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Small Logo -->
                            <Image Source="/app_icon.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                            <TextBlock Text="打开网址的方式"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#A5A5B8"
                                       FontFamily="{StaticResource FluentFont}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Top Right Window Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource FluentSubtleButton}"
                                    Click="SettingsButton_Click"
                                    ToolTip="偏好与分流规则设置"
                                    Padding="6,3"
                                    Margin="0,0,4,0">
                                <ui:SymbolIcon Symbol="Settings20" Foreground="#B0B0C0" />
                            </Button>
                            <Button Style="{StaticResource FluentSubtleButton}"
                                    Click="CloseButton_Click"
                                    ToolTip="关闭 (Esc)"
                                    Padding="6,3">
                                <ui:SymbolIcon Symbol="Dismiss16" Foreground="#B0B0C0" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- URL Capsule Pill -->
                    <Border Grid.Row="1"
                            Background="#18FFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Globe20"
                                           Foreground="{StaticResource AccentLightBrush}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       x:Name="UrlDisplayBlock"
                                       FontFamily="{StaticResource FluentFont}">
                                <Run x:Name="UrlHostRun" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentLightBrush}" />
                                <Run x:Name="UrlPathRun" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </TextBlock>

                            <!-- Copy Button -->
                            <Button Grid.Column="2"
                                    x:Name="CopyButton"
                                    Style="{StaticResource FluentSubtleButton}"
                                    Click="CopyButton_Click"
                                    ToolTip="复制网址到剪贴板 (Ctrl+C)"
                                    Padding="8,4"
                                    Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy16" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CopyLabelText" Text="复制" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. Browser Cards List -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="460"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,10">
                    <Grid>
                        <!-- Empty Notice -->
                        <Border x:Name="EmptyBrowsersNotice"
                                Background="#14FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,24"
                                Margin="0,4,0,4"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.6" />
                                <TextBlock Text="未检测到已启用的浏览器" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="请在偏好设置中添加浏览器可执行文件或扫描系统" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,14" HorizontalAlignment="Center" />
                                <Button Style="{StaticResource FluentPrimaryButton}"
                                        Click="SettingsButton_Click"
                                        Content="⚙ 打开偏好设置"
                                        Padding="16,6"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="BrowsersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BrowserItem}">
                                <ui:CardAction IsChevronVisible="False"
                                               Click="BrowserCard_Click"
                                               Tag="{Binding}"
                                               Margin="0,0,0,8"
                                               Padding="12,10"
                                               HorizontalContentAlignment="Stretch">
                                    <ui:CardAction.Style>
                                        <Style TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                    <Setter Property="Background" Value="#1E38BDF8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:CardAction.Style>
                                    <ui:CardAction.ContextMenu>
                                        <ContextMenu Background="#1E1E2C" BorderBrush="#35354A" BorderThickness="1">
                                            <MenuItem Header="✏️ 编辑显示名称与标签..."
                                                      Click="EditBrowserContextMenuItem_Click"
                                                      Foreground="#FFFFFF" />
                                            <MenuItem Header="📂 打开安装目录..."
                                                      Click="OpenBrowserLocationContextMenuItem_Click"
                                                      Foreground="#E2E8F0" />
                                        </ContextMenu>
                                    </ui:CardAction.ContextMenu>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                CornerRadius="8"
                                                Background="#0AFFFFFF">
                                            <Image Source="{Binding Icon}"
                                                   Width="30"
                                                   Height="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Browser Info & Profiles -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Browser Name, Tag & Running Badge -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F3F3F5"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FluentFont}" />

                                                <!-- Tag Pill Badge -->
                                                <Border CornerRadius="4"
                                                        Background="#1838BDF8"
                                                        BorderBrush="#3338BDF8"
                                                        BorderThickness="1"
                                                        Padding="5,1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasTag, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="{Binding Tag}"
                                                               FontSize="10"
                                                               FontWeight="Medium"
                                                               Foreground="#7DD3FC"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Running indicator -->
                                                <Border CornerRadius="8"
                                                        Background="#1E10B981"
                                                        BorderBrush="#3310B981"
                                                        BorderThickness="1"
                                                        Padding="5,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="已在后台运行中，打开极速"
                                                        Visibility="{Binding IsRunning, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="运行中" FontSize="10.5" Foreground="#10B981" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Profiles row if any -->
                                            <ItemsControl ItemsSource="{Binding Profiles}"
                                                          Margin="0,5,0,0"
                                                          Visibility="{Binding HasProfiles, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:BrowserProfileItem}">
                                                        <Button Style="{StaticResource FluentSubtleButton}"
                                                                Background="#1AFFFFFF"
                                                                BorderBrush="#25FFFFFF"
                                                                BorderThickness="1"
                                                                Padding="6,2"
                                                                Margin="0,0,6,3"
                                                                Click="ProfileButton_Click"
                                                                Tag="{Binding}"
                                                                ToolTip="{Binding Name, StringFormat='使用配置文件「{0}」直接打开'}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="👤" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Right: Privacy Button & Hotkey Badge -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- Privacy Mode Quick Button -->
                                            <Button Style="{StaticResource FluentSubtleButton}"
                                                    Background="#1AFFFFFF"
                                                    BorderBrush="#20FFFFFF"
                                                    BorderThickness="1"
                                                    Padding="7,3"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Click="PrivacyModeButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="以无痕 / 隐私模式打开 (Alt + 快捷键)"
                                                    Visibility="{Binding HasPrivacyMode, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Glasses16" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="无痕" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Number Hotkey Badge -->
                                            <Border CornerRadius="6"
                                                    Background="#25FFFFFF"
                                                    BorderBrush="#38FFFFFF"
                                                    BorderThickness="1"
                                                    Padding="8,3"
                                                    MinWidth="24"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasHotkey, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding HotkeyLabel}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="#E2E8F0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- 3. Bottom Toolbar & Legend -->
                <Border Grid.Row="2"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Remember choice checkbox -->
                        <CheckBox Grid.Column="0"
                                  x:Name="RememberDomainCheckBox"
                                  Style="{StaticResource FluentCheckBox}"
                                  VerticalAlignment="Center"
                                  ToolTip="下次打开相同域名的链接时自动使用当前所选浏览器">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="记住此域名的选择"
                                           FontSize="12"
                                           Foreground="#CBD5E1"
                                           FontFamily="{StaticResource FluentFont}" />
                                <TextBlock Text=" [Space]"
                                           FontSize="10.5"
                                           Foreground="#64748B"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <!-- Shortcut hints legend -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="[↑/↓] 选中"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,0,8,0"
                                       FontFamily="{StaticResource FluentFont}" />
                            <TextBlock Text="[Enter/数字] 打开"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,0,8,0"
                                       FontFamily="{StaticResource FluentFont}" />
                            <TextBlock Text="[Alt+Enter] 无痕"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,0,8,0"
                                       FontFamily="{StaticResource FluentFont}" />
                            <TextBlock Text="[Esc] 取消"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       FontFamily="{StaticResource FluentFont}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
