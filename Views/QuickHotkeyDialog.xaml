<Window x:Class="LinkFlow.Views.QuickHotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置专属快捷键"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#1A1A26"
            BorderBrush="#383850"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Browser Info & Hotkey Box -->
                <RowDefinition Height="Auto" /> <!-- Instructions -->
                <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Keyboard24" Foreground="#38BDF8" Margin="0,0,8,0" FontSize="18" />
                    <TextBlock Text="设置专属快捷键"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource FluentSubtleButton}"
                        Click="CancelButton_Click"
                        Padding="6,4"
                        VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Dismiss16" Foreground="#94A3B8" />
                </Button>
            </Grid>

            <!-- 2. Target Browser & Hotkey Display -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <Border Background="#12121E"
                        BorderBrush="#262638"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="28"
                                Height="28"
                                CornerRadius="6"
                                Background="#10FFFFFF"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <Image x:Name="BrowserIconImage"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BrowserNameText"
                                       Text="Google Chrome"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="在弹出选择器中可按此键直接启动"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Big Key Display -->
                <Border Background="#0C253B"
                        BorderBrush="#0284C7"
                        BorderThickness="2"
                        CornerRadius="10"
                        Height="56"
                        HorizontalAlignment="Center"
                        MinWidth="90"
                        Padding="16,4">
                    <TextBlock x:Name="HotkeyDisplayText"
                               Text="1"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- 3. Instructions -->
            <StackPanel Grid.Row="2" Margin="0,0,0,18" HorizontalAlignment="Center">
                <TextBlock Text="💡 直接在键盘上按下数字或字母键即可设定"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center" />
                <TextBlock Text="按【Backspace】或【Delete】清除，按【Esc】取消"
                           FontSize="11"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- 4. Footer Buttons -->
            <Grid Grid.Row="3">
                <Button Style="{StaticResource FluentSubtleButton}"
                        Click="ClearButton_Click"
                        HorizontalAlignment="Left"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete16" Foreground="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="清除快捷键" FontSize="11.5" Foreground="#EF4444" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Secondary"
                               Click="CancelButton_Click"
                               Margin="0,0,8,0"
                               Padding="14,6"
                               Content="取消" />
                    <ui:Button Appearance="Primary"
                               Click="ConfirmButton_Click"
                               Padding="16,6"
                               Content="确定" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
