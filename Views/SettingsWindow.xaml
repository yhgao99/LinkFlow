                                </StackPanel>

                                <!-- Preferences Group using Windows 11 CardControl -->
                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="默认记住域名选择" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
