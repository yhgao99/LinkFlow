                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Delete16" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Bottom Save & Close row -->
                <Border Grid.Row="2"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="0,1,0,0"
                        Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Primary"
                                   Click="SaveAndCloseButton_Click"
                                   Content="保存并关闭"
                                   Padding="22,7">
