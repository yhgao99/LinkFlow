<ui:FluentWindow x:Class="LinkFlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LinkFlow.Models"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="LinkFlow - 规则与偏好设置"
        Width="960"
        Height="700"
        MinWidth="800"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="#F3F3F3"
        FontFamily="{StaticResource FluentFont}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Windows 11 Navigation Item Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Left Active Indicator Pill -->
                                <Border x:Name="indicator"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="1.5"
                                        Background="#38BDF8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="1,0,0,0"
                                        Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E38BDF8" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="SelectionBrush" Value="#0078D4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem Global Clean Style (Stretch without blue selection) -->
        <Style x:Key="CleanListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Windows 11 Native TitleBar -->
            <RowDefinition Height="*" />    <!-- Content Body (Sidebar + Right Pane) -->
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent Native TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="TitleBar"
                     Title="LinkFlow"
                     Icon="/app_icon.png" />

        <!-- Two-column Body: Left Sidebar + Right Tab Pages -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDEBAR ================= -->
            <Border Grid.Column="0"
                    Background="#0AFFFFFF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,12,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- App Header / Brand -->
                        <RowDefinition Height="*" />    <!-- Nav Items -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Guide / Version -->
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <StackPanel Grid.Row="0" Margin="6,2,6,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/app_icon.png" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="LinkFlow" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="浏览器智能分流与配置" FontSize="11" Foreground="#94A3B8" Margin="32,2,0,0" />
                    </StackPanel>

                    <!-- Vertical Navigation List -->
                    <StackPanel Grid.Row="1">
                        <!-- Nav 0: 浏览器管理 -->
                        <RadioButton x:Name="NavBtnBrowsers"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     IsChecked="True"
                                     Tag="0"
                                     Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Globe20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="浏览器与配置" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Nav 1: 智能分流规则 -->
                        <RadioButton x:Name="NavBtnRules"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Tag="1"
                                     Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="BranchFork20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="智能分流规则" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Nav 2: 常规偏好与系统 -->
                        <RadioButton x:Name="NavBtnPreferences"
                                     GroupName="SidebarNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Tag="2"
                                     Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="常规偏好与系统" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Guide Button & Version Info -->
                    <StackPanel Grid.Row="2" Margin="2,0,2,0">
                        <ui:Button Appearance="Transparent"
                                   Click="OpenOnboardingGuideButton_Click"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="10,8"
                                   Margin="0,0,0,10"
                                   ToolTip="打开初次使用配置引导向导与工作原理说明">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="BookOpen20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="新手使用指南" VerticalAlignment="Center" FontSize="12.5" />
                            </StackPanel>
                        </ui:Button>

                        <Border BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="4,8,4,0">
                            <TextBlock Text="LinkFlow v1.0.0" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= RIGHT MAIN CONTENT ================= -->
            <Grid Grid.Column="1" Margin="24,12,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Banner if any -->
                    <RowDefinition Height="*" />    <!-- Content Pages (TabControl without header) -->
                    <RowDefinition Height="Auto" /> <!-- Bottom Save Bar -->
                </Grid.RowDefinitions>

                <!-- Default Browser Warning Banner -->
                <Border Grid.Row="0"
                        x:Name="DefaultBrowserBanner"
                        Background="#1A0284C7"
                        BorderBrush="#400284C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,9"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="温馨提示：LinkFlow 尚未设为系统默认浏览器，在其他应用中点击链接可能不会弹出此选择器。"
                                       FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary"
                                       Click="OpenOnboardingGuideButton_Click"
                                       Content="立即打开配置向导"
                                       Padding="12,4"
                                       FontSize="11.5"
                                       Margin="0,0,8,0" />
                            <ui:Button Appearance="Transparent"
                                       Click="DismissBanner_Click"
                                       Padding="6,4">
                                <ui:SymbolIcon Symbol="Dismiss16" Foreground="#94A3B8" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TAB CONTROL (Headers hidden, controlled by Left Sidebar) -->
                <TabControl Grid.Row="1"
                            x:Name="MainTabControl"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ================= TAB 1: 浏览器管理 ================= -->
                    <TabItem Header="浏览器与配置">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Page Header -->
                                <RowDefinition Height="Auto" /> <!-- Action Toolbar -->
                                <RowDefinition Height="*" />    <!-- Browser Cards List -->
                            </Grid.RowDefinitions>

                            <!-- Page Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="浏览器与独立配置" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="管理系统检测到或自定义添加的浏览器实例、自定义标签及独立 Profile 运行环境"
                                           FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Action Toolbar -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Primary"
                                               Click="AddBrowserButton_Click"
                                               Content="手动添加 (exe / lnk)"
                                               Margin="0,0,8,0"
                                               Padding="14,6">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Add20" />
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:Button Appearance="Secondary"
                                               Click="ImportFolderButton_Click"
                                               Content="导入文件夹..."
                                               Margin="0,0,8,0"
                                               Padding="12,6"
                                               ToolTip="选择任意文件夹，自动递归扫描并批量导入其中的浏览器与快捷方式">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen20" />
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:Button Appearance="Secondary"
                                               Click="RescanBrowsersButton_Click"
                                               Content="重新扫描系统"
                                               Margin="0,0,8,0"
                                               Padding="12,6">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowClockwise20" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>

                                <TextBlock Text="💡 支持直接拖拽快捷方式或文件夹至窗口添加"
                                           FontSize="11.5"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Browser Cards List -->
                            <Border Grid.Row="2"
                                    Background="#0AFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8">
                                <ListBox x:Name="BrowsersListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AllowDrop="True"
                                         PreviewDragOver="BrowsersListBox_PreviewDragOver"
                                         PreviewDrop="BrowsersListBox_PreviewDrop"
                                         DragLeave="BrowsersListBox_DragLeave"
                                         ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:BrowserItem}">
                                            <!-- 单层容器：卡片主体 + 悬浮指示线，杜绝任何高度跳变引发的抖动 -->
                                            <Grid Margin="0,0,0,5">
                                                <!-- Card Body -->
                                                <Border BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,9"
                                                        HorizontalAlignment="Stretch"
                                                        ToolTip="💡 双击运行测试，右键快速排序或管理"
                                                        MouseLeftButtonDown="BrowserCard_MouseLeftButtonDown">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="🔝 置于顶端 (第一位)" Click="MoveToTop_Click" />
                                                            <MenuItem Header="⬆ 上移一位" Click="MoveUp_Click" />
                                                            <MenuItem Header="⬇ 下移一位" Click="MoveDown_Click" />
                                                            <MenuItem Header="🔻 置于底端 (末尾)" Click="MoveToBottom_Click" />
                                                            <Separator />
                                                            <MenuItem Header="⏸ 停用 / 启用此浏览器" Click="ToggleBrowserEnabledContext_Click" />
                                                            <MenuItem Header="▶ 启动测试 (about:blank)" Click="LaunchTest_Click" />
                                                            <MenuItem Header="✎ 编辑属性与参数..." Click="EditBrowserContext_Click" />
                                                            <Separator />
                                                            <MenuItem Header="🗑 移除此配置" Click="DeleteBrowserContext_Click" Foreground="#EF4444" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#12FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#1EFFFFFF" />
                                                            <Setter Property="Opacity" Value="{Binding StatusOpacity}" />
                                                            <Style.Triggers>
                                                                <!-- 正在被拖拽的卡片：半透明凹槽质感，微缩放并呈现蓝边 -->
                                                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.28" />
                                                                    <Setter Property="Background" Value="#06FFFFFF" />
                                                                    <Setter Property="BorderBrush" Value="#0284C7" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" /> <!-- Drag Handle -->
                                                            <ColumnDefinition Width="Auto" /> <!-- Icon -->
                                                            <ColumnDefinition Width="*" />    <!-- Details -->
                                                            <ColumnDefinition Width="Auto" /> <!-- Actions & Hotkey -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Drag Handle (上下拖拽排序) -->
                                                        <Border Grid.Column="0"
                                                                Width="24"
                                                                Height="40"
                                                                CornerRadius="6"
                                                                Cursor="SizeAll"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="按住上下拖拽调整顺序"
                                                                PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                                PreviewMouseMove="DragHandle_PreviewMouseMove">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#1838BDF8" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="⋮⋮"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="#64748B"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Icon -->
                                                        <Border Grid.Column="1"
                                                                Width="40"
                                                                Height="40"
                                                                CornerRadius="7"
                                                                Background="#10FFFFFF"
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                            <Image Source="{Binding Icon}"
                                                                   Width="30"
                                                                   Height="30"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>

                                                        <!-- Details -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13.5"
                                                                           Foreground="#FFFFFF"
                                                                           VerticalAlignment="Center" />

                                                                <!-- Tag Pill Badge -->
                                                                <Border CornerRadius="4"
                                                                        Background="#1838BDF8"
                                                                        BorderBrush="#3338BDF8"
                                                                        BorderThickness="1"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasTag, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                                    <TextBlock Text="{Binding Tag}"
                                                                               FontSize="10.5"
                                                                               FontWeight="Medium"
                                                                               Foreground="#7DD3FC"
                                                                               VerticalAlignment="Center" />
                                                                </Border>

                                                                <!-- Disabled badge -->
                                                                <Border CornerRadius="4"
                                                                        Background="#25EF4444"
                                                                        BorderBrush="#40EF4444"
                                                                        BorderThickness="1"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding IsDisabled, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                                    <TextBlock Text="已停用"
                                                                               FontSize="10.5"
                                                                               FontWeight="Medium"
                                                                               Foreground="#F87171"
                                                                               VerticalAlignment="Center" />
                                                                </Border>

                                                                <!-- Profile count badge (可点击查看、启动或提取) -->
                                                                <Border CornerRadius="6"
                                                                        Background="#1AFFFFFF"
                                                                        BorderBrush="#25FFFFFF"
                                                                        BorderThickness="1"
                                                                        Padding="7,2"
                                                                        Margin="8,0,0,0"
                                                                        Cursor="Hand"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasProfiles, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}"
                                                                        ToolTip="点击查看配置文件、启动测试或提取为独立卡片"
                                                                        MouseLeftButtonDown="ProfilesBadge_MouseLeftButtonDown"
                                                                        Tag="{Binding}">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Profiles.Count, StringFormat='👥 {0} 个配置文件'}"
                                                                                   FontSize="11"
                                                                                   Foreground="#94A3B8" />
                                                                        <TextBlock Text=" ▾"
                                                                                   FontSize="10"
                                                                                   Foreground="#64748B"
                                                                                   Margin="3,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Custom Arguments Pill Badge (高亮启动参数，区分Chrome实例) -->
                                                                <Border CornerRadius="4"
                                                                        Background="#1422C55E"
                                                                        BorderBrush="#2E22C55E"
                                                                        BorderThickness="1"
                                                                        Padding="6,1.5"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasCustomArgs, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}"
                                                                        ToolTip="{Binding CommandArgs, StringFormat='附加启动参数:&#x0a;{0}'}">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="⚙ "
                                                                                   FontSize="9"
                                                                                   Foreground="#4ADE80" />
                                                                        <TextBlock Text="{Binding CommandArgs}"
                                                                                   FontSize="10.5"
                                                                                   FontFamily="Consolas, Cascadia Code, Segoe UI"
                                                                                   Foreground="#4ADE80"
                                                                                   MaxWidth="320"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Exe Path -->
                                                            <TextBlock Text="{Binding ExePath, Mode=OneWay}"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Actions & Hotkey -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Hotkey Pill (点击快速配置快捷键) -->
                                                            <Border CornerRadius="5"
                                                                    Background="#1B2838"
                                                                    BorderBrush="#0284C7"
                                                                    BorderThickness="1"
                                                                    Padding="8,2.5"
                                                                    Margin="0,0,10,0"
                                                                    Cursor="Hand"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasHotkey, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}"
                                                                    ToolTip="点击快速修改此浏览器的专属快捷键"
                                                                    MouseLeftButtonDown="HotkeyBadge_MouseLeftButtonDown"
                                                                    Tag="{Binding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding HotkeyLabel}"
                                                                               FontWeight="Bold"
                                                                               FontSize="11.5"
                                                                               Foreground="#38BDF8" />
                                                                    <TextBlock Text=" ▾"
                                                                               FontSize="9"
                                                                               Foreground="#0284C7"
                                                                               VerticalAlignment="Center"
                                                                               Margin="3,0,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <ui:Button Appearance="Transparent"
                                                                       Click="EditBrowser_Click"
                                                                       Tag="{Binding}"
                                                                       Padding="6,4"
                                                                       Margin="0,0,3,0"
                                                                       ToolTip="编辑显示名称、启动参数与标签">
                                                                <ui:SymbolIcon Symbol="Edit16" />
                                                            </ui:Button>

                                                            <ui:Button Appearance="Danger"
                                                                       Click="DeleteBrowser_Click"
                                                                       Tag="{Binding}"
                                                                       Padding="6,4"
                                                                       ToolTip="从列表中移除">
                                                                <ui:SymbolIcon Symbol="Delete16" />
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Top Drop Indicator (发光灵动蓝线，悬浮叠加层，零布局抖动) -->
                                                <Grid VerticalAlignment="Top"
                                                      Margin="6,-3,6,0"
                                                      Height="6"
                                                      IsHitTestVisible="False">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDropTargetTop}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.10" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.08" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid VerticalAlignment="Center" Height="4">
                                                        <!-- 渐变发光霓虹蓝线 -->
                                                        <Border CornerRadius="2" Height="3" Margin="8,0,0,0">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#38BDF8" Offset="0.0" />
                                                                    <GradientStop Color="#818CF8" Offset="0.6" />
                                                                    <GradientStop Color="#00818CF8" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" Color="#38BDF8" ShadowDepth="0" Opacity="0.95" />
                                                            </Border.Effect>
                                                        </Border>
                                                        <!-- 左侧灵动发光圆点 (Pin Dot) -->
                                                        <Ellipse Width="7" Height="7" Fill="#FFFFFF" Stroke="#38BDF8" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="6" Color="#38BDF8" ShadowDepth="0" Opacity="1.0" />
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                </Grid>

                                                <!-- Bottom Drop Indicator (发光灵动蓝线，悬浮叠加层，零布局抖动) -->
                                                <Grid VerticalAlignment="Bottom"
                                                      Margin="6,0,6,-3"
                                                      Height="6"
                                                      IsHitTestVisible="False">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDropTargetBottom}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.10" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.08" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid VerticalAlignment="Center" Height="4">
                                                        <!-- 渐变发光霓虹蓝线 -->
                                                        <Border CornerRadius="2" Height="3" Margin="8,0,0,0">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#38BDF8" Offset="0.0" />
                                                                    <GradientStop Color="#818CF8" Offset="0.6" />
                                                                    <GradientStop Color="#00818CF8" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" Color="#38BDF8" ShadowDepth="0" Opacity="0.95" />
                                                            </Border.Effect>
                                                        </Border>
                                                        <!-- 左侧灵动发光圆点 (Pin Dot) -->
                                                        <Ellipse Width="7" Height="7" Fill="#FFFFFF" Stroke="#38BDF8" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="6" Color="#38BDF8" ShadowDepth="0" Opacity="1.0" />
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ================= TAB 2: 智能分流规则 ================= -->
                    <TabItem Header="智能分流规则">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Header & Presets -->
                                <RowDefinition Height="Auto" /> <!-- Add Form Card -->
                                <RowDefinition Height="*" />    <!-- Rules List -->
                                <RowDefinition Height="Auto" /> <!-- Live Tester -->
                            </Grid.RowDefinitions>

                            <!-- Header & Quick Presets -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="智能分流规则" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <Border CornerRadius="9"
                                                Background="#1E38BDF8"
                                                BorderBrush="#3338BDF8"
                                                BorderThickness="1"
                                                Padding="7,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="RulesCountBadge" Text="0 条" FontSize="10.5" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="匹配域名、URL 路径或正则时秒级自动导向特定浏览器，无需手动挑选"
                                               FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Quick Preset Pills -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="常用预设:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ui:Button Appearance="Secondary" Content="🏢 办公" Tag="work" Click="PresetButton_Click" Padding="8,3" Margin="0,0,4,0" FontSize="11.5" ToolTip="快速填入飞书/钉钉域名" />
                                    <ui:Button Appearance="Secondary" Content="🐙 开发者" Tag="dev" Click="PresetButton_Click" Padding="8,3" Margin="0,0,4,0" FontSize="11.5" ToolTip="快速填入 github.com 规则" />
                                    <ui:Button Appearance="Secondary" Content="🎬 视频" Tag="video" Click="PresetButton_Click" Padding="8,3" Margin="0,0,4,0" FontSize="11.5" ToolTip="快速填入 bilibili.com 规则" />
                                    <ui:Button Appearance="Secondary" Content="💻 本地" Tag="local" Click="PresetButton_Click" Padding="8,3" FontSize="11.5" ToolTip="快速填入 localhost 规则" />
                                </StackPanel>
                            </Grid>

                            <!-- Add / Edit Rule Form -->
                            <Border Grid.Row="1"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,9"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,7">
                                        <TextBlock x:Name="RuleFormTitleBlock"
                                                   Text="➕ 新建分流规则"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#38BDF8"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="CancelEditRuleButton"
                                                Style="{StaticResource FluentSubtleButton}"
                                                Content="✕ 取消编辑"
                                                Click="CancelEditRule_Click"
                                                HorizontalAlignment="Right"
                                                Padding="8,2"
                                                FontSize="11"
                                                Foreground="#94A3B8"
                                                Visibility="Collapsed" />
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.3*" />
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Pattern Input with Placeholder -->
                                        <Grid Grid.Column="0" Margin="0,0,6,0">
                                            <TextBox x:Name="RulePatternBox"
                                                     Height="32"
                                                     Padding="10,0"
                                                     GotFocus="RulePatternBox_GotFocus"
                                                     LostFocus="RulePatternBox_LostFocus"
                                                     TextChanged="RulePatternBox_TextChanged" />
                                            <TextBlock x:Name="RulePatternPlaceholder"
                                                       Text="主域名或关键词 (如 bilibili.com)"
                                                       Foreground="#55FFFFFF"
                                                       FontSize="11.5"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                        </Grid>

                                        <!-- Match Type Combo -->
                                        <ComboBox Grid.Column="1"
                                                  x:Name="RuleMatchTypeCombo"
                                                  Height="32"
                                                  DisplayMemberPath="Display"
                                                  Margin="0,0,6,0" />

                                        <!-- Target Browser Combo -->
                                        <ComboBox Grid.Column="2"
                                                  x:Name="RuleTargetBrowserCombo"
                                                  Height="32"
                                                  DisplayMemberPath="Name"
                                                  Margin="0,0,6,0" />

                                        <!-- Target Profile Combo -->
                                        <ComboBox Grid.Column="3"
                                                  x:Name="RuleTargetProfileCombo"
                                                  Height="32"
                                                  DisplayMemberPath="Display"
                                                  Margin="0,0,6,0" />

                                        <!-- Submit Rule Button -->
                                        <ui:Button Grid.Column="4"
                                                   x:Name="SubmitRuleButton"
                                                   Appearance="Primary"
                                                   Click="AddRuleButton_Click"
                                                   Height="32"
                                                   Padding="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SubmitRuleIcon" Text="➕" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11" />
                                                <TextBlock x:Name="SubmitRuleText" Text="添加规则" FontSize="11.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Rules List -->
                            <Border Grid.Row="2"
                                    Background="#0AFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6">
                                <Grid>
                                    <Border x:Name="EmptyRulesNotice"
                                            Background="#08FFFFFF"
                                            CornerRadius="8"
                                            Padding="20"
                                            Margin="4"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.6" />
                                            <TextBlock Text="暂未创建分流规则" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="点击上方常用预设或直接在上方表单添加规则" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <ListBox x:Name="RulesListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:RoutingRule}">
                                                <Border Background="#12FFFFFF"
                                                        BorderBrush="#1CFFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="10,7"
                                                        Margin="0,0,0,5"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" /> <!-- Match Type Badge -->
                                                            <ColumnDefinition Width="*" />    <!-- Pattern -->
                                                            <ColumnDefinition Width="Auto" /> <!-- Arrow -->
                                                            <ColumnDefinition Width="Auto" /> <!-- Target Browser & Profile -->
                                                            <ColumnDefinition Width="Auto" /> <!-- Toggle -->
                                                            <ColumnDefinition Width="Auto" /> <!-- Actions -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Match Type Badge -->
                                                        <Border Grid.Column="0"
                                                                Background="#1AFFFFFF"
                                                                BorderBrush="#25FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="5,1.5"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MatchTypeDisplay}"
                                                                       FontSize="10.5"
                                                                       Foreground="#94A3B8" />
                                                        </Border>

                                                        <!-- Pattern -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Pattern}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12.5"
                                                                   Foreground="#FFFFFF"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <!-- Arrow -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="➜"
                                                                   FontSize="11"
                                                                   Foreground="#64748B"
                                                                   Margin="8,0,8,0"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Target Browser & Profile -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding TargetBrowserName}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="#E2E8F0"
                                                                       VerticalAlignment="Center" />
                                                            <Border Background="#1838BDF8"
                                                                    BorderBrush="#3338BDF8"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="4,1"
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasTargetBrowserTag, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                                <TextBlock Text="{Binding TargetBrowserTag}"
                                                                           FontSize="10"
                                                                           Foreground="#7DD3FC" />
                                                            </Border>
                                                            <Border Background="#25818CF8"
                                                                    BorderBrush="#40818CF8"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="4,1"
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasTargetProfile, Converter={x:Static models:BooleanToVisibilityConverter.Instance}}">
                                                                <TextBlock Text="{Binding TargetProfileName}"
                                                                           FontSize="10"
                                                                           Foreground="#A5B4FC" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Toggle Switch -->
                                                        <ui:ToggleSwitch Grid.Column="4"
                                                                         IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                         Click="RuleToggle_Click"
                                                                         Tag="{Binding}"
                                                                         Margin="0,0,10,0"
                                                                         VerticalAlignment="Center"
                                                                         ToolTip="开启或停用此条分流规则" />

                                                        <!-- Action Buttons -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Appearance="Transparent"
                                                                       Click="EditRule_Click"
                                                                       Tag="{Binding}"
                                                                       Padding="5,3"
                                                                       Margin="0,0,2,0"
                                                                       ToolTip="编辑规则">
                                                                <ui:SymbolIcon Symbol="Edit16" />
                                                            </ui:Button>
                                                            <ui:Button Appearance="Transparent"
                                                                       Click="MoveRuleUp_Click"
                                                                       Tag="{Binding}"
                                                                       Padding="5,3"
                                                                       Margin="0,0,2,0"
                                                                       ToolTip="上移优先级">
                                                                <ui:SymbolIcon Symbol="ArrowUp16" />
                                                            </ui:Button>
                                                            <ui:Button Appearance="Transparent"
                                                                       Click="MoveRuleDown_Click"
                                                                       Tag="{Binding}"
                                                                       Padding="5,3"
                                                                       Margin="0,0,4,0"
                                                                       ToolTip="下移优先级">
                                                                <ui:SymbolIcon Symbol="ArrowDown16" />
                                                            </ui:Button>
                                                            <ui:Button Appearance="Danger"
                                                                       Click="DeleteRule_Click"
                                                                       Tag="{Binding}"
                                                                       Padding="5,3"
                                                                       ToolTip="删除此规则">
                                                                <ui:SymbolIcon Symbol="Delete16" />
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Collapsible Interactive Rule Tester -->
                            <Border Grid.Row="3"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,6,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Tester Toggle Header -->
                                    <Grid Grid.Row="0">
                                        <Button x:Name="RuleTesterToggle"
                                                Style="{StaticResource FluentSubtleButton}"
                                                Click="RuleTesterToggle_Click"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0,2">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🧪" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="实时分流规则匹配测试器"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="#E2E8F0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="(输入网址立即验证会命中哪个浏览器)"
                                                               FontSize="11"
                                                               Foreground="#64748B"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock x:Name="RuleTesterToggleArrow"
                                                           Text="▼"
                                                           FontSize="10"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0" />
                                            </Grid>
                                        </Button>
                                    </Grid>

                                    <!-- Collapsible Tester Body Grid -->
                                    <Grid Grid.Row="1"
                                          x:Name="RuleTesterBodyGrid"
                                          Margin="0,8,0,0"
                                          Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Quick Test Pills WrapPanel -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="测试目标:" FontWeight="SemiBold" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <WrapPanel Grid.Column="1"
                                                       x:Name="QuickTestPillsPanel"
                                                       Orientation="Horizontal"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- URL Input + Paste -->
                                        <Grid Grid.Row="1" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                                <TextBox x:Name="TesterUrlBox"
                                                         Height="32"
                                                         Padding="10,0,26,0"
                                                         GotFocus="TesterUrlBox_GotFocus"
                                                         LostFocus="TesterUrlBox_LostFocus"
                                                         TextChanged="TesterUrlBox_TextChanged" />
                                                <TextBlock x:Name="TesterPlaceholder"
                                                           Text="粘贴网址，或直接点击上方测试示例"
                                                           Foreground="#55FFFFFF"
                                                           FontSize="11.5"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False" />
                                                <Button HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#64748B"
                                                        Cursor="Hand"
                                                        Click="ClearTesterButton_Click"
                                                        ToolTip="清空输入框">
                                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" />
                                                </Button>
                                            </Grid>

                                            <ui:Button Grid.Column="1"
                                                       Appearance="Secondary"
                                                       Click="PasteTesterClipboardButton_Click"
                                                       Height="32"
                                                       Padding="10,0"
                                                       ToolTip="一键读取剪贴板链接并填入测试">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📋" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="11" />
                                                    <TextBlock Text="粘贴剪贴板" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>

                                        <!-- Dynamic Result Card -->
                                        <Border Grid.Row="2"
                                                x:Name="TesterResultBorder"
                                                Background="#12FFFFFF"
                                                BorderBrush="#1EFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TesterResultIcon" Text="💡" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" />
                                                    <TextBlock x:Name="TesterResultText"
                                                               Text="输入网址或点击上方测试示例，实时查看分流走向"
                                                               FontSize="11.5"
                                                               Foreground="#94A3B8"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button x:Name="TesterLaunchButton"
                                                               Appearance="Primary"
                                                               Click="TesterLaunchButton_Click"
                                                               Padding="10,3"
                                                               Height="26"
                                                               Visibility="Collapsed"
                                                               ToolTip="在目标浏览器中真实打开此测试链接进行最终验证">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🚀" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="10" />
                                                            <TextBlock Text="实际打开验证" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <ui:Button x:Name="TesterTestPickerButton"
                                                               Appearance="Secondary"
                                                               Click="TesterTestPickerButton_Click"
                                                               Padding="10,3"
                                                               Height="26"
                                                               Margin="6,0,0,0"
                                                               Visibility="Collapsed"
                                                               ToolTip="立即弹出选择器界面进行模拟测试">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🧪" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="10" />
                                                            <TextBlock Text="弹出选择器测试" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
