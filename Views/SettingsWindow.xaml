                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:CardControl.Icon>
                                        <ui:SymbolIcon Symbol="Dismiss24" Foreground="#38BDF8" />
                                    </ui:CardControl.Icon>
                                    <ui:ToggleSwitch x:Name="AutoCloseOnLostFocusCheck" />
