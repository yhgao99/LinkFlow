                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:CardControl.Icon>
                                        <ui:SymbolIcon Symbol="Link24" Foreground="#38BDF8" />
                                    </ui:CardControl.Icon>
                                    <ui:ToggleSwitch x:Name="ResolveShortUrlsCheck" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="屏蔽外部浏览器默认提示" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="启动 Chromium 核心浏览器时自动注入 --no-default-browser-check，防止浏览器弹窗询问设为默认" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:CardControl.Icon>
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#38BDF8" />
