                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:CardControl.Icon>
                                        <ui:SymbolIcon Symbol="QuestionCircle24" Foreground="#38BDF8" />
                                    </ui:CardControl.Icon>
                                    <ui:ToggleSwitch x:Name="AlwaysPromptCheck" />
                                </ui:CardControl>

                                <ui:CardControl Margin="0,0,0,8">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="自动展开短网址重定向" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
