                                                           FontWeight="SemiBold"
                                                           Foreground="#34D399" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="将 LinkFlow 设为系统默认浏览器后，在微信、QQ、钉钉、VS Code 等任意外部应用中点击链接，都会由本工具智能秒级分流或弹出选择。"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"
                                                   Margin="0,0,0,12" />

                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Appearance="Primary"
