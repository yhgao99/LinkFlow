<Window x:Class="LinkFlow.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="欢迎使用 LinkFlow - 快速入门指引"
        Width="700"
        Height="630"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Modern Pill Tag -->
        <Style x:Key="FlowStepPill" TargetType="Border">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Window.Resources>

    <!-- Outer Container with Shadow and 16px Rounded Corners -->
    <Border Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Border CornerRadius="16"
                Background="#F0181824"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1.2"
                ClipToBounds="True">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Title Bar -->
                    <RowDefinition Height="*" />    <!-- Content Guide Cards -->
                    <RowDefinition Height="Auto" /> <!-- Bottom Action Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header & Title Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/app_icon.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <TextBlock Text="欢迎使用 LinkFlow"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="完成系统默认浏览器绑定，即可在任意软件中享受智能链接分流"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="36,4,0,0" />
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource FluentSubtleButton}"
                            Click="CloseButton_Click"
                            ToolTip="关闭"
                            Padding="8,5"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Dismiss16" Foreground="#B0B0C0" />
                    </Button>
                </Grid>

                <!-- 2. Content Guide Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,6,0">

                        <!-- STEP 1: 原理说明 -->
                        <Border Background="#16FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="💡 第一步：了解它是如何工作的"
                                               FontWeight="Bold"
                                               FontSize="13.5"
                                               Foreground="#38BDF8" />
                                </StackPanel>

                                <!-- Visual Flow Diagram -->
                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Step 1.1 -->
                                    <Border Grid.Column="0" Style="{StaticResource FlowStepPill}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="💬 外部应用" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            <TextBlock Text="微信/QQ/邮件/文档" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="➔" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0" />

                                    <!-- Step 1.2 -->
                                    <Border Grid.Column="2" Style="{StaticResource FlowStepPill}" Background="#1E2238" BorderBrush="#38BDF8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⚡ LinkFlow" FontWeight="SemiBold" FontSize="12.5" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                            <TextBlock Text="自动接管打开请求" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="➔" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0" />

                                    <!-- Step 1.3 -->
                                    <Border Grid.Column="4" Style="{StaticResource FlowStepPill}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🚀 智能打开" FontWeight="SemiBold" FontSize="12.5" Foreground="#10B981" HorizontalAlignment="Center" />
                                            <TextBlock Text="自动秒开或弹出选择" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- STEP 2: 关键配置 - 设为系统默认浏览器 -->
                        <Border Background="#16FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="⚙️ 第二步：设为 Windows 系统默认浏览器 (必须)"
                                               FontWeight="Bold"
                                               FontSize="13.5"
                                               Foreground="#F59E0B"
                                               VerticalAlignment="Center" />

                                    <!-- Live Status Badge -->
                                    <Border Grid.Column="1"
                                            x:Name="DefaultStatusBadge"
                                            Background="#2010B981"
                                            BorderBrush="#4010B981"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,3">
                                        <TextBlock x:Name="DefaultStatusText"
                                                   Text="检测状态中..."
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#34D399" />
                                    </Border>
                                </Grid>

                                <!-- Guide steps -->
                                <StackPanel Margin="0,2,0,12">
                                    <Border Background="#14000000" CornerRadius="8" Padding="12,8" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="① 点击下方按钮，程序将完成协议注册并打开 Windows「默认应用」设置"
                                                       FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                            <TextBlock Text="② 在「Web 浏览器」中选择「LinkFlow」即可完成绑定"
                                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FluentPrimaryButton}"
                                            Click="SetDefaultButton_Click"
                                            Margin="0,0,10,0"
                                            Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="一键注册并打开 Windows 设置" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource FluentSubtleButton}"
                                            Background="#1C1C2A"
                                            BorderBrush="#2E2E44"
                                            BorderThickness="1"
                                            Click="CheckStatusButton_Click"
                                            Padding="14,8"
                                            ToolTip="重新检测当前系统默认设置状态">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="刷新检测状态" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- STEP 3: 立即模拟测试效果 -->
                        <Border Background="#16FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="🎯 第三步：立即实测体验"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="#10B981"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="无需退出程序打开其他软件，点击下方按钮即可立刻体验拦截弹出与规则分流效果："
                                           FontSize="12"
                                           Foreground="#CBD5E1"
                                           Margin="0,0,0,10" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FluentSubtleButton}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Click="TestOpenGeneralLink_Click"
                                            Margin="0,0,10,0"
                                            Padding="14,8"
                                            ToolTip="模拟打开任意普通链接，触发 Fluent 选择器弹窗">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌐" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="模拟点击普通网址 (测试弹窗)" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource FluentSubtleButton}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Click="TestOpenRuleLink_Click"
                                            Padding="14,8"
                                            ToolTip="模拟打开已配置分流规则的链接，体验全自动静默秒开">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🐙" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="模拟点击 GitHub 链接 (测试自动分流)" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Bottom Bar: Do not show again & Finish -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="DoNotShowAgainCheck"
                              Style="{StaticResource FluentCheckBox}"
                              Content="已知晓原理，下次启动不再自动弹出此指引"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary"
                                   Click="OpenSettingsButton_Click"
                                   Margin="0,0,10,0"
                                   Padding="16,8"
                                   Content="打开高级设置">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Settings20" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button Appearance="Primary"
                                   Click="FinishButton_Click"
                                   Padding="20,8"
                                   Content="完成配置，开始使用">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Checkmark20" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
